# Sao chép thành .env rồi chỉnh. Không commit file .env.
APP_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cho_cong_dong
BIND_ADDR=0.0.0.0:8080

# Bí mật ký JWT, ít nhất 32 ký tự. Đổi giá trị này ở mọi môi trường thật.
JWT_SECRET=doi-gia-tri-nay-thanh-chuoi-ngau-nhien-dai-hon-32-ky-tu

# Cookie refresh token: bật Secure khi chạy HTTPS.
COOKIE_SECURE=false
# Các origin được phép gọi API, phân cách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:5173
# Bật khi chạy sau proxy (Fly, Cloudflare) để lấy IP thật từ header.
TRUST_PROXY=false

RATE_LIMIT_IP_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_USER_PER_MIN=600

# Argon2id: mặc định theo khuyến nghị OWASP (19 MiB, 2 vòng).
ARGON2_M_KIB=19456
ARGON2_T=2

LOG_JSON=false
RUST_LOG=info

# ---- Phase 2: thanh toán ----
# manual (mặc định, admin xác nhận tay) | payos | fake (chỉ dev/test)
PAYMENT_GATEWAY=manual
# Thông tin hiển thị cho chuyển khoản thủ công.
MANUAL_BANK_NAME=Ngân hàng của bạn
MANUAL_ACCOUNT_NO=0000000000
MANUAL_ACCOUNT_NAME=TEN CHU TAI KHOAN
# PayOS (chỉ cần khi PAYMENT_GATEWAY=payos)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/wallet
PAYOS_CANCEL_URL=http://localhost:5173/wallet

# ---- Phase 2: mã hóa thông tin ngân hàng (KYC) ----
# Dạng id:base64(32 byte), nhiều khóa cách nhau bằng dấu phẩy. Tạo khóa: openssl rand -base64 32
# Để trống khi dev: dùng khóa dev cố định (KHÔNG dùng cho dữ liệu thật). Bắt buộc ở production.
KYC_KEYS=
KYC_ACTIVE_KEY=

# ---- Phase 3: lưu trữ tệp private & quét virus ----
# local (dev/test) | s3 (Cloudflare R2 / S3-compatible)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/uploads
STORAGE_DOWNLOAD_SECRET=
PUBLIC_BASE_URL=http://localhost:8080
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Địa chỉ clamd (vd: 127.0.0.1:3310). Để trống khi dev nếu chưa bật container clamav.
CLAMD_ADDR=
